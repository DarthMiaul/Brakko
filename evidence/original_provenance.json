 "result": {
  "final_name": "Brakko",
  "tagline": "Three sneakers, one jaw, zero doubts. Mostly.",
  "caption": "Skipped leg day twice as hard. Grinned anyway.",
  "character": {
   "form": "A hulking Harambe silverback gorilla with a black-furred Doge Shiba head, Pepe the Frog's heavy-lidded eyes under Wojak's worried brows, a Trollface grin cut across a bearded Gigachad jaw, NPC Wojak flat grey skin, standing on Tralalero Tralala's three blue-sneakered legs and shouldering Tung Tung Tung Sahur's wooden bat.",
   "face": "Pepe the Frog's big round white eyes with heavy half-closed upper lids give a sleepy-smug stare; thin tilted Wojak worry-brows sit just above them on a flat NPC-grey brow ridge; Doge's short black muzzle with black nose and flared cheek tufts leads down to Trollface's enormous crooked toothy grin that stretches past the cheeks, which in turn is framed by Gigachad's razor-square jaw, sharp cheekbones and short black trimmed beard. Expression: supreme unearned confidence with a tiny flicker of doubt.",
   "body_and_colors": "Massive top-heavy gorilla torso, broad shoulders, long heavy arms reaching the ground, three short stocky legs; one material of short black fur over flat grey skin. Palette of five flat colours: black fur, flat NPC grey (skin and back saddle), white (sclera, teeth, swooshes), bright blue (sneakers) and warm brown (wooden bat only). Fur drawn in clean chunky tufts, skin perfectly flat, thin confident black outlines.",
   "pose": "Standing tall on three sneakers in a slight three-quarter turn, Shiba head cocked back over the shoulder, bat resting on one shoulder, the other knuckles on the ground.",
   "vibe": "Unearned supreme confidence with a hint of doubt",
   "signature": "The chiselled bearded Gigachad jaw with a full Trollface grin on a black-furred Shiba-headed gorilla standing on three blue sneakers."
  },
  "base_character": "Harambe",
  "build": [
   {
    "slot": "body",
    "from_character": "Harambe",
    "trait": "silverback gorilla build: huge dark-furred body, long heavy arms, grey silver back",
    "how": "The entire creature is one hulking black-furred silverback gorilla torso with long knuckle-dragging arms and a flat grey saddle across the broad back; everything else grows out of this body."
   },
   {
    "slot": "head",
    "from_character": "Doge",
    "trait": "Shiba Inu head: round fluffy cheeks, short muzzle, small triangular upright ears, black nose",
    "how": "The gorilla's head is a round Shiba Inu head with two small triangular upright ears, flared fluffy cheek tufts and a short muzzle with a black nose, all in the same black fur as the body."
   },
   {
    "slot": "pose",
    "from_character": "Doge",
    "trait": "head tilted and turned over the shoulder, viewed from a slight three-quarter angle",
    "how": "The body faces slightly away while the Shiba head is cocked and turned back over the silver shoulder in the classic Doge three-quarter look."
   },
   {
    "slot": "eyes",
    "from_character": "Pepe the Frog",
    "trait": "big round eyes with heavy half-closed upper lids and large white sclera, sleepy-smug",
    "how": "Two big round eyes with bright white sclera and heavy drooping upper lids sit under the brow ridge, giving the sleepy-smug Pepe stare."
   },
   {
    "slot": "face",
    "from_character": "Wojak",
    "trait": "sad furrowed brows and blank worried stare",
    "how": "Thin tilted Wojak worry-brows are drawn on the grey brow ridge right above the heavy Pepe lids, so the smug stare carries a visible flicker of doubt."
   },
   {
    "slot": "mouth",
    "from_character": "Trollface",
    "trait": "Trollface grin: enormous crooked grin stretching past the cheeks, a full row of big visible teeth",
    "how": "A giant crooked grin with a full row of big square white teeth is cut across the lower muzzle, stretching wider than the fluffy cheek tufts, with a few scribbly wrinkle folds at its corners."
   },
   {
    "slot": "jaw",
    "from_character": "Gigachad",
    "trait": "extremely chiselled square jawline and sharp cheekbones with a short dark trimmed beard",
    "how": "Below the grin the muzzle resolves into a razor-sharp square Gigachad jaw with angular cheekbones and a tight black trimmed beard along the jawline."
   },
   {
    "slot": "skin_or_palette",
    "from_character": "NPC Wojak",
    "trait": "flat grey skin, no colour at all",
    "how": "All bare skin (face, brow ridge, chest, palms) is the flat featureless NPC grey with zero shading; the silver saddle on the back is the same flat grey."
   },
   {
    "slot": "feet",
    "from_character": "Tralalero Tralala",
    "trait": "three legs each wearing a bright blue Nike-style sneaker with a white swoosh",
    "how": "The gorilla stands on three short stocky black-furred legs, each ending in a chunky bright blue sneaker with a white swoosh, planted in a wide tripod."
   },
   {
    "slot": "accessory",
    "from_character": "Tung Tung Tung Sahur",
    "trait": "a wooden baseball bat held in one hand",
    "how": "One long gorilla arm rests a polished warm-brown wooden baseball bat with visible grain rings over the shoulder; the other knuckles touch the ground."
   }
  ],
  "name_rejected": []
 },
